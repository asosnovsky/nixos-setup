							<path d="M150.0 108.0 L202.7 204.1 L174.8 205.7 L160.8 179.3 L143.8 205.7 L128.3 205.7 L120.5 191.7 L146.9 151.4 L131.4 126.6 Z" fill="url(#shardA)"/>
							<path d="M198.0 150.0 L248.4 222.6 L226.1 226.2 L212.7 206.3 L201.3 228.8 L188.8 230.1 L181.4 219.6 L199.2 185.1 L184.7 166.5 Z" fill="url(#shardB)"/>
							<path d="M56 214 L108 168 L128 190 L146 156 L170 196 L196 166 L230 198 L244 214 L244 244 L56 244 Z" fill="#415E9A" opacity="0.92"/>
							<path d="M108 168 L128 190 L112 206 Z" fill="#7EBAE4"/>
							<path d="M170 196 L196 166 L214 188 Z" fill="#649AFA"/>
							<path d="M132 176 L150 148 L164 170" fill="none" stroke="#F4FBFF" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>
						</g>
						<polygon points="146,28 244,82 244,190 146,244 48,190 48,82" fill="none" stroke="#5277C3" stroke-width="3.25" stroke-linejoin="round"/>
						<g fill="none" stroke="#4A6BAF" stroke-width="1.35" stroke-linecap="round">
							<path d="M146 62 V78"/>
							<path d="M146 62 H172 L184 74"/>
							<path d="M172 62 V50"/>
						</g>
						<g fill="#649AFA">
							<circle cx="146" cy="56" r="3"/>
							<circle cx="172" cy="62" r="2.1"/>
							<circle cx="184" cy="74" r="2.1"/>
							<circle cx="150" cy="108" r="2.4"/>
						</g>
					</g>
					<g id="wordmark">
						<text x="286" y="176" font-family="Montserrat, Segoe UI, Century Gothic, Futura, sans-serif" font-size="92" font-weight="600" letter-spacing="-1.2" fill="#1E3A66">Sky<tspan fill="#5277C3">G</tspan></text>
						<path d="M290 196 H408" fill="none" stroke="#7EBAE4" stroke-width="1.7" stroke-linecap="round"/>
						<circle cx="418" cy="196" r="2.2" fill="#649AFA"/>
						<path d="M428 196 H452" fill="none" stroke="#7EBAE4" stroke-width="1.7" stroke-linecap="round"/>
					</g>
				</svg>
			</div>
			<p class="skyg-tagline">Ariel Sosnovsky's Personal Projects and stuff</p>
		</div>

		<section class="skyg-projects">
			<h2 class="skyg-projects-title">Projects</h2>
			<div class="skyg-projects-list">
				<a class="skyg-repo" href="https://gitea.skyg.ca/ari/nixos-setup">
					<span class="skyg-repo-logo">
						<img src="https://discourse.nixos.org/uploads/default/optimized/3X/d/b/dbc323aade42f2b3a6efb5b3d72ea0a496f9e1aa_2_570x500.png" alt="nixos-setup logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">nixos-setup</span>
				</a>
				<a class="skyg-repo" href="https://gitea.skyg.ca/ari/homelab">
					<span class="skyg-repo-logo">
						<img src="/assets/skyg/homelab.jpg" alt="homelab logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">homelab</span>
				</a>
				<a class="skyg-repo" href="https://gitea.skyg.ca/ari/Shortumation">
					<span class="skyg-repo-logo">
						<img src="https://gitea.skyg.ca/ari/Shortumation/raw/branch/main/logo.png" alt="Shortumation logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">Shortumation</span>
				</a>
				<a class="skyg-repo" href="https://gitea.skyg.ca/ari/hermenix">
					<span class="skyg-repo-logo">
						<img src="/assets/skyg/hermenix.jpg" alt="hermenix logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">hermenix</span>
				</a>
				<a class="skyg-repo" href="https://gitea.skyg.ca/ari/flic2hass">
					<span class="skyg-repo-logo">
						<img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRDAvBCgiUJM60gxt0UazzlhFNNeTHm4RddEaJ_gF4AeWlJTRdDShqenlA&amp;s=10" alt="flic2hass logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">flic2hass</span>
				</a>
				<a class="skyg-repo" href="https://gitea.skyg.ca/ari/skygqts">
					<span class="skyg-repo-logo">
						<img src="https://gitea.skyg.ca/ari/skygqts/raw/branch/main/logo.jpg" alt="skygqts logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">skygqts</span>
				</a>
				<a class="skyg-repo" href="https://github.com/asosnovsky/ha-textbelt">
					<span class="skyg-repo-logo">
						<img src="https://gitea.skyg.ca/ari/ha-textbelt/raw/branch/main/assets/logo_black_transparent.png" alt="ha-textbelt logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">ha-textbelt</span>
				</a>
				<a class="skyg-repo" href="https://gitea.skyg.ca/ari/pdfmajor">
					<span class="skyg-repo-logo">
						<img src="/assets/skyg/pdfmajor.png" alt="pdfmajor logo" loading="lazy">
					</span>
					<span class="skyg-repo-name">pdfmajor</span>
				</a>
			</div>
		</section>

		<style>
			.skyg-hero {
				text-align: center;
				padding: 56px 12px 24px;
			}
			.skyg-logo {
				max-width: 520px;
				margin: 0 auto;
				animation: skyg-rise .7s ease both;
			}
			.skyg-logo svg {
				display: block;
				width: 100%;
				height: auto;
			}
			.skyg-tagline {
				margin: 24px 0 0;
				font-size: 1.35rem;
				font-weight: 500;
				opacity: .75;
				animation: skyg-rise .7s .12s ease both;
			}
			@keyframes skyg-rise {
				from { opacity: 0; transform: translateY(14px); }
				to { opacity: 1; transform: translateY(0); }
			}
			@media (max-width: 480px) {
				.skyg-hero { padding-top: 32px; }
				.skyg-tagline { font-size: 1.1rem; }
			}
			@media (prefers-reduced-motion: reduce) {
				.skyg-logo,
				.skyg-tagline { animation: none !important; }
			}

			.skyg-projects {
				max-width: 760px;
				margin: 8px auto 64px;
				padding: 0 12px;
			}
			.skyg-projects-title {
				margin: 0 0 20px;
				font-size: 1.6rem;
				font-weight: 600;
				text-align: center;
				letter-spacing: .01em;
			}
			.skyg-projects-list {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 14px;
			}
			.skyg-repo {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 12px;
				padding: 18px;
				border-radius: 14px;
				border: 1px solid rgba(82, 119, 195, .28);
				background: rgba(126, 186, 228, .08);
				text-decoration: none;
				color: inherit;
				transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
			}
			.skyg-repo:hover {
				transform: translateY(-3px);
				border-color: #5277C3;
				box-shadow: 0 14px 30px -18px rgba(82, 119, 195, .8);
			}
			.skyg-repo-logo {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100%;
				height: 120px;
				border-radius: 10px;
				overflow: hidden;
				background: rgba(255, 255, 255, .55);
			}
			.skyg-repo-logo img {
				max-width: 100%;
				max-height: 100%;
				object-fit: contain;
			}
			.skyg-repo-name {
				font-size: 1.05rem;
				font-weight: 600;
				color: #5277C3;
				text-align: center;
				word-break: break-word;
			}
		</style>

	</div>
</div>
{{template "base/footer" .}}
